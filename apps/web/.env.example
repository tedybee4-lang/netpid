# ---------------------------------------------------------------------------
# TEMPLATE ONLY - never run the app against these values.
#
# Copy to .env.local and REPLACE EVERY VALUE with the real ones from
# Supabase -> Project Settings -> API (plus the server-only secrets).
#
# Leaving `replace-me` / localhost placeholders here is the #1 cause of the
# "Invalid API key" error: the app boots and renders, but every Supabase call
# is rejected. Verified error shapes:
#   bad anon key -> 401 {"error_code":"invalid_api_key","msg":"Invalid API key"}
#   good anon key -> 400 {"error_code":"invalid_credentials"} on a bad login
#
# Next.js only reads .env.local from the APP ROOT, so the real file must be at
# apps/web/.env.local and `npm run dev` must be run from apps/web.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose
APP_ENCRYPTION_KEY=generate-32-byte-base64
PAYHERO_WEBHOOK_SECRET=replace-me
