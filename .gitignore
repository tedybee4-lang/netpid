# Supabase CLI local state (project ref, version pins, pooler URL)
supabase/.temp/

# Never commit real credentials (use .env.example as the template)
.env.local
.env*.local
node_modules/
apps/web/.next/

# Pasted content from the editor session. This is scratch input that can contain
# pasted credentials (VPS details, keys, tokens) and must never be committed.
.kalai/

# SSH / VPS credential material, in case a details file is ever saved locally.
*vps*.txt
*vps*.json
*VPS*.txt
*VPS*.json
id_rsa
id_ed25519
*.pem
ssh_known_hosts

# Local dev-server log (scratch output, never committed)
apps/web/dev_out.txt

# Build / typecheck artefacts
*.tsbuildinfo
apps/web/next-env.d.ts

