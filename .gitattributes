# Shell scripts, unit files and FreeRADIUS/Postgres config are executed or
# parsed by tools on a Linux VPS. A CRLF left in any of them is not cosmetic:
# a CRLF in a bash script turns `set -euo pipefail` into `pipefail\r` and the
# script dies with "invalid option name"; systemd ignores a unit with CRLF;
# radiusd and psql both choke on it. Normalising here is cheaper than
# rediscovering it on a live box.
* text=auto

*.sh    text eol=lf
*.sql   text eol=lf
*.conf  text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.md    text eol=lf
*.service text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Keep binaries out of text conversion.
*.tar.gz binary
*.png  binary
*.jpg  binary
*.ico  binary
