# NETPID worker environment — copy to /etc/netpid/worker.env, then:
#   chmod 600 /etc/netpid/worker.env && chown root:root /etc/netpid/worker.env
#
# This file holds live credentials. It must never be committed, never pasted
# into chat, and never world-readable.

# --- Console wiring --------------------------------------------------------

# The vps_servers.id of THIS box, as a UUID. The heartbeat is rejected with 404
# if it does not match, and an unset value makes the worker refuse to beat
# rather than report a false "ok".
NETPID_SERVER_ID=

# Shared secret for POST /api/worker/heartbeat. Must equal the
# WORKER_HEARTBEAT_SECRET configured in Vercel. While it is unset the endpoint
# fails closed with 503 and the console can never show this box as online.
WORKER_HEARTBEAT_SECRET=

# Optional: defaults to the production console.
NETPID_HEARTBEAT_URL=https://netpid.vercel.app/api/worker/heartbeat

# Optional: pin the reported worker id. When unset it is derived from
# /etc/machine-id, which is already stable — set it only to give the box a
# human-readable name in the Super Admin workers table.
# WORKER_ID=lipanet-core

# --- Supabase (app database) ----------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Credentials at rest ---------------------------------------------------
# 32 bytes, base64. Must be IDENTICAL to the APP_ENCRYPTION_KEY in Vercel: the
# console writes encrypted router credentials that only this worker can read.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes every already-stored credential undecryptable.
APP_ENCRYPTION_KEY=

# --- RADIUS (radius_db on this host, NOT the Supabase app DB) -------------
# Leave unset to run the worker without RADIUS; it starts and says so loudly.
# RADIUS_DB_URL=postgres://radius_sync:CHANGE_ME@127.0.0.1:5432/radius_db

# --- Optional integrations -------------------------------------------------
# PAYHERO_API_KEY=
# TOPSPEED_API_KEY=
